        b.AnchorPoint = Vector2.new(0,1)
        b.BackgroundColor3 = BAR_COLS[((i-1) % #BAR_COLS)+1]
        b.BorderSizePixel = 0 b.Parent = eqFrame
        Instance.new("UICorner",b).CornerRadius = UDim.new(0,2)
        bars[i] = b
