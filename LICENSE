    T.RGB:AddTextBox({ Name="Texto da RP Bio", Default="Fantasma1l Hub | discord.gg/bXuvVw76B", PlaceholderText="Digite a bio...",
        Callback=function(v) FantasmaRP.BioText=tostring(v or "") end })
