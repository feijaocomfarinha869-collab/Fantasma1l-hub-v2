local function notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 5
        })
    end)
    print("[NOTIFICAÇÃO] " .. title .. ": " .. text)
end

-- ================== LEVEL 188 "COURTYARD OF WINDOWS" ==================
local LEVEL188 = {
    token = 0, S = nil, saved = nil, hidden = {},
    MODEL_ID = "15169021437",
}

do
    local LIGHT_PROPS = {
        "Ambient", "OutdoorAmbient", "Brightness", "ClockTime", "FogColor", "FogStart", "FogEnd",
        "GlobalShadows", "ExposureCompensation", "EnvironmentDiffuseScale", "EnvironmentSpecularScale",
    }

    local function loadModel(id)
        local m
        local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(id)) end)
        if ok and objs and objs[1] then
            m = objs[1]
            if #objs > 1 or not m:IsA("Model") then
                local wrap = Instance.new("Model")
                for _, o in ipairs(objs) do o.Parent = wrap end
                m = wrap
            end
        end
        if not m then
            local ok2, m2 = pcall(function() return game:GetService("InsertService"):LoadAsset(tonumber(id)) end)
            if ok2 and m2 then m = m2 end
        end
        return m
    end

    function LEVEL188.clear(silent)
        LEVEL188.token += 1
        local S = LEVEL188.S
        LEVEL188.S = nil
        if S and S.folder then pcall(function() S.folder:Destroy() end) end
        if S and S.charConn then pcall(function() S.charConn:Disconnect() end) end
        for _, n in ipairs({ "L188_CC", "L188_Atm" }) do
            local o = Lighting:FindFirstChild(n)
            if o then o:Destroy() end
        end
        for _, a in ipairs(LEVEL188.hidden) do pcall(function() a.Parent = Lighting end) end
        LEVEL188.hidden = {}
        if LEVEL188.saved then
            for k, v in pairs(LEVEL188.saved) do pcall(function() Lighting[k] = v end) end
            LEVEL188.saved = nil
        end
        if S and not silent then notify("Level 188", "Você saiu do Courtyard of Windows.") end
        return true
    end

    function LEVEL188.spawn(partnerName)
        notify("Level 188", "Carregando o Courtyard of Windows...")
        LEVEL188.clear(true)
        local myToken = LEVEL188.token

        local S = {}
        LEVEL188.S = S
        local folder = Instance.new("Folder")
        folder.Name = "Level188_Courtyard"
        folder.Parent = workspace
        S.folder = folder

        -- ===== carrega o modelo =====
        local model = loadModel(LEVEL188.MODEL_ID)
        if LEVEL188.token ~= myToken then return end
        if not model then
            notify("Level 188", "Não consegui carregar o mapa (ID " .. LEVEL188.MODEL_ID .. ").")
            pcall(function() folder:Destroy() end)
            LEVEL188.S = nil
            return
        end

        local partCount = 0
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Anchored = true
                p.CanCollide = true
                p.CanQuery = true
                partCount += 1
            end
        end
        if partCount == 0 then
            notify("Level 188", "O modelo carregou mas não tem nenhuma peça.")
            pcall(function() folder:Destroy() end)
            LEVEL188.S = nil
            return
        end
        if not model.PrimaryPart then
            model.PrimaryPart = model:FindFirstChildWhichIsA("BasePart", true)
        end
        model.Parent = folder

        -- ===== POSICIONA O MAPA E ACHA O CHÃO =====
        local MAPBASE = Vector3.new(19000, 400, 0)
        local bcf0, bs0 = model:GetBoundingBox()
        -- coloca a base do mapa em MAPBASE
        local offY = model:GetPivot().Position.Y - (bcf0.Position.Y - bs0.Y / 2)
        model:PivotTo(CFrame.new(MAPBASE.X, MAPBASE.Y + offY, MAPBASE.Z))

        local bcf, bsize = model:GetBoundingBox()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = { model }

        local spawnCF
        local bottomY = bcf.Position.Y - bsize.Y / 2
        local startY  = bottomY + 45   -- começa perto do chão, abaixo dos tetos

        -- grade de pontos: centro + anéis em volta
        local tries = { Vector3.zero }
        for _, rad in ipairs({ 0.1, 0.2, 0.3, 0.4 }) do
            for i = 1, 12 do
                local a = i / 12 * math.pi * 2
                table.insert(tries, Vector3.new(
                    math.cos(a) * bsize.X * rad, 0, math.sin(a) * bsize.Z * rad))
            end
        end

        for _, o in ipairs(tries) do
            local res = workspace:Raycast(
                Vector3.new(bcf.Position.X + o.X, startY, bcf.Position.Z + o.Z),
                Vector3.new(0, -120, 0), params)
            -- só aceita se for chão de verdade (perto da base), não teto
            if res and res.Position.Y < bottomY + 30 then
                spawnCF = CFrame.new(res.Position + Vector3.new(0, 4, 0))
                break
            end
        end

        if not spawnCF then
            -- nada achado: plataforma na base do mapa pra não cair no vazio
            local plat = Instance.new("Part")
            plat.Anchored = true
            plat.Transparency = 1
            plat.Size = Vector3.new(40, 1, 40)
            plat.Position = Vector3.new(bcf.Position.X, bottomY + 0.5, bcf.Position.Z)
            plat.Parent = folder
            spawnCF = CFrame.new(bcf.Position.X, bottomY + 5, bcf.Position.Z)
        end

        -- ===== iluminação =====
        LEVEL188.saved = {}
        for _, k in ipairs(LIGHT_PROPS) do pcall(function() LEVEL188.saved[k] = Lighting[k] end) end
        pcall(function()
            for _, c in ipairs(Lighting:GetChildren()) do
                if c:IsA("Atmosphere") then table.insert(LEVEL188.hidden, c) c.Parent = nil end
            end
        end)
        local function set(k, v) pcall(function() Lighting[k] = v end) end
        set("ClockTime", 13)
        set("Brightness", 1.4)
        set("Ambient", Color3.fromRGB(150, 150, 150))
        set("OutdoorAmbient", Color3.fromRGB(150, 150, 150))
        set("FogColor", Color3.fromRGB(210, 210, 210))
        set("FogStart", 40)
        set("FogEnd", 260)
        set("GlobalShadows", true)
        set("ExposureCompensation", -0.1)
        pcall(function()
            local cc = Instance.new("ColorCorrectionEffect")
            cc.Name = "L188_CC"
            cc.Saturation = -0.35
            cc.Contrast = 0.1
            cc.Brightness = -0.02
            cc.Parent = Lighting
            local atm = Instance.new("Atmosphere")
            atm.Name = "L188_Atm"
            atm.Density = 0.16
            atm.Offset = 0
            atm.Color = Color3.fromRGB(205, 205, 205)
            atm.Decay = Color3.fromRGB(150, 150, 150)
            atm.Glare, atm.Haze = 0, 0.5
            atm.Parent = Lighting
        end)

        -- ===== FADE PRETO + TELEPORTE =====
        task.spawn(function()
            local pg = LocalPlayer:WaitForChild("PlayerGui")
            local fadeGui = Instance.new("ScreenGui")
            fadeGui.Name = "Level188Fade"
            fadeGui.IgnoreGuiInset = true
            fadeGui.ResetOnSpawn = false
            fadeGui.DisplayOrder = 999
            fadeGui.Parent = pg

            local fadeFrame = Instance.new("Frame")
            fadeFrame.Size = UDim2.new(1, 0, 1, 0)
            fadeFrame.BackgroundColor3 = Color3.new(0, 0, 0)
            fadeFrame.BackgroundTransparency = 1
            fadeFrame.BorderSizePixel = 0
            fadeFrame.Parent = fadeGui

            local fadeOut = TweenService:Create(fadeFrame, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0 })
            fadeOut:Play()
            fadeOut.Completed:Wait()

            if LEVEL188.token ~= myToken then
                if fadeGui then fadeGui:Destroy() end
                return
            end

            local chr = LocalPlayer.Character
            local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Anchored = true
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = spawnCF
                task.wait(0.6)   -- dá tempo do mapa/colisão assentar antes de soltar
                hrp.Anchored = false
            end

            if partnerName and partnerName ~= "" then
                local partner = Players:FindFirstChild(partnerName)
                if partner and partner ~= LocalPlayer and partner.Character
                    and partner.Character:FindFirstChild("HumanoidRootPart") then
                    partner.Character.HumanoidRootPart.CFrame = spawnCF + Vector3.new(3, 0, 0)
                end
            end

            task.wait(0.6)
            local fadeIn = TweenService:Create(fadeFrame, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 })
            fadeIn:Play()
            fadeIn.Completed:Wait()

            if fadeGui then fadeGui:Destroy() end
            notify("Level 188", "Pronto! Courtyard of Windows carregado.")
        end)

        -- ===== respawn automático de volta pro mapa =====
        S.charConn = LocalPlayer.CharacterAdded:Connect(function(c)
            local h = c:WaitForChild("HumanoidRootPart", 10)
            if h and LEVEL188.token == myToken then
                task.wait(0.5)
                h.AssemblyLinearVelocity = Vector3.zero
                h.CFrame = spawnCF
            end
        end)

        return true
    end
end

-- ================== SALA BRANCA (dimensão própria, lá no céu) ==================
local SALABRANCA = { token = 0, S = nil, saved = nil, hidden = {} }

do
    local BASE = Vector3.new(9000, 5000, 0)   -- bem longe do mapa, lá em cima
    local CW, CH, CL = 7, 4.2, 10

    local function mk(parent, size, cf, color, mat, collide)
        local p = Instance.new("Part")
        p.Anchored = true
        p.Size = size
        p.CFrame = cf
        p.Color = color
        p.Material = mat or Enum.Material.Concrete
        p.CanCollide = collide ~= false
        p.CanQuery = collide ~= false
        p.CanTouch = false
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        p.Parent = parent
        return p
    end

    local LIGHT_PROPS = {
        "Ambient", "OutdoorAmbient", "Brightness", "ClockTime", "FogColor", "FogStart", "FogEnd",
        "GlobalShadows", "ExposureCompensation", "EnvironmentDiffuseScale", "EnvironmentSpecularScale",
    }

    function SALABRANCA.clear(silent)
        SALABRANCA.token += 1
        local S = SALABRANCA.S
        SALABRANCA.S = nil
        if S and S.folder then pcall(function() S.folder:Destroy() end) end
        local o = Lighting:FindFirstChild("SalaBranca_CC")
        if o then o:Destroy() end
        for _, a in ipairs(SALABRANCA.hidden) do pcall(function() a.Parent = Lighting end) end
        SALABRANCA.hidden = {}
        if SALABRANCA.saved then
            for k, v in pairs(SALABRANCA.saved) do pcall(function() Lighting[k] = v end) end
            SALABRANCA.saved = nil
        end
        if S and not silent then notify("Sala Branca", "Você saiu da Sala Branca.") end
        return true
    end

    function SALABRANCA.spawn(partnerName)
        notify("Sala Branca", "Gerando a Sala Branca...")
        SALABRANCA.clear(true)
        local myToken = SALABRANCA.token

        local S = {}
        SALABRANCA.S = S
        local folder = Instance.new("Folder")
        folder.Name = "SalaBranca"
        folder.Parent = workspace
        S.folder = folder

        local floorCol  = Color3.fromRGB(78, 64, 46)   -- carpete marrom
        local wallCol   = Color3.fromRGB(205, 195, 175) -- parede bege clara
        local ceilCol   = Color3.fromRGB(245, 245, 240)

        mk(folder, Vector3.new(CW, 0.3, CL), CFrame.new(BASE) * CFrame.new(0, 0.15, 0), floorCol, Enum.Material.Fabric, true)
        mk(folder, Vector3.new(CW, 0.3, CL), CFrame.new(BASE) * CFrame.new(0, CH - 0.15, 0), ceilCol, Enum.Material.SmoothPlastic, true)
        mk(folder, Vector3.new(0.3, CH, CL), CFrame.new(BASE) * CFrame.new(-CW / 2, CH / 2, 0), wallCol, Enum.Material.Concrete, true)
        mk(folder, Vector3.new(0.3, CH, CL), CFrame.new(BASE) * CFrame.new(CW / 2, CH / 2, 0), wallCol, Enum.Material.Concrete, true)
        mk(folder, Vector3.new(CW + 0.3, CH, 0.3), CFrame.new(BASE) * CFrame.new(0, CH / 2, -CL / 2), wallCol, Enum.Material.Concrete, true)
        mk(folder, Vector3.new(CW + 0.3, CH, 0.3), CFrame.new(BASE) * CFrame.new(0, CH / 2, CL / 2), wallCol, Enum.Material.Concrete, true)

        local light = mk(folder, Vector3.new(2.2, 0.2, 0.7), CFrame.new(BASE) * CFrame.new(0, CH - 0.25, 0), Color3.fromRGB(255, 255, 250), Enum.Material.Neon, false)
        local pl = Instance.new("PointLight")
        pl.Color, pl.Range, pl.Brightness = Color3.fromRGB(255, 250, 240), 24, 1.6
        pl.Parent = light

        -- ponto de spawn no TETO da sala: você nasce lá em cima e cai dentro dela
        local spawnPos = BASE + Vector3.new(0, CH - 0.6, 0)
        local spawnCF = CFrame.new(spawnPos, spawnPos + Vector3.new(0, -1, -0.3))

        SALABRANCA.saved = {}
        for _, k in ipairs(LIGHT_PROPS) do pcall(function() SALABRANCA.saved[k] = Lighting[k] end) end
        pcall(function()
            for _, c in ipairs(Lighting:GetChildren()) do
                if c:IsA("Atmosphere") then table.insert(SALABRANCA.hidden, c) c.Parent = nil end
            end
        end)
        local function set(k, v) pcall(function() Lighting[k] = v end) end
        set("ClockTime", 13)
        set("Brightness", 1.3)
        set("Ambient", Color3.fromRGB(160, 155, 145))
        set("OutdoorAmbient", Color3.fromRGB(160, 155, 145))
        set("FogColor", Color3.fromRGB(200, 195, 185))
        set("FogStart", 20)
        set("FogEnd", 120)
        pcall(function()
            local cc = Instance.new("ColorCorrectionEffect")
            cc.Name = "SalaBranca_CC"
            cc.Saturation = -0.3
            cc.Contrast = 0.1
            cc.Parent = Lighting
        end)

        local function teleportMe()
            local chr = LocalPlayer.Character
            local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Anchored = true
                hrp.CFrame = spawnCF
                task.wait(0.3)
                hrp.Anchored = false
            end
        end
        teleportMe()
        if partnerName and partnerName ~= "" then
            local partner = Players:FindFirstChild(partnerName)
            if partner and partner.Character and partner.Character:FindFirstChild("HumanoidRootPart") then
                partner.Character.HumanoidRootPart.CFrame = spawnCF + Vector3.new(1.5, 0, 0)
            end
        end

        S.charConn = LocalPlayer.CharacterAdded:Connect(function(c)
            local h = c:WaitForChild("HumanoidRootPart", 10)
            if h and SALABRANCA.token == myToken then
                task.wait(0.5)
                h.AssemblyLinearVelocity = Vector3.zero
                h.CFrame = spawnCF
            end
        end)

        notify("Sala Branca", "Pronto! Você nasce no teto e cai dentro da sala.")
        return true
    end
end

-- ================== ILHA DO BLOX (mapa do Blox Fruits + águas) ==================
local ILHABLOX = {
    token = 0, S = nil, saved = nil, hidden = {},
    MODEL_ID = "89625645114556",     -- ilha (mapa do Blox Fruits)
    WATER_ID = "11387489894",        -- águas / mar em volta da ilha
}

do
    local BASE = Vector3.new(14000, 6000, 0)   -- bem longe do mapa, lá em cima

    local LIGHT_PROPS = {
        "Ambient", "OutdoorAmbient", "Brightness", "ClockTime", "FogColor", "FogStart", "FogEnd",
        "GlobalShadows", "ExposureCompensation", "EnvironmentDiffuseScale", "EnvironmentSpecularScale",
    }

    function ILHABLOX.clear(silent)
        ILHABLOX.token += 1
        local S = ILHABLOX.S
        ILHABLOX.S = nil
        if S and S.folder then pcall(function() S.folder:Destroy() end) end
        for _, a in ipairs(ILHABLOX.hidden) do pcall(function() a.Parent = Lighting end) end
        ILHABLOX.hidden = {}
        if ILHABLOX.saved then
            for k, v in pairs(ILHABLOX.saved) do pcall(function() Lighting[k] = v end) end
            ILHABLOX.saved = nil
        end
        if S and not silent then notify("Ilha do Blox", "Você saiu da Ilha do Blox.") end
        return true
    end

    -- carrega um asset como Model (GetObjects + fallback InsertService)
    local function loadModel(id)
        local m
        local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(id)) end)
        if ok and objs and objs[1] then
            m = objs[1]
            if not m:IsA("Model") then
                local wrap = Instance.new("Model")
                for _, o in ipairs(objs) do o.Parent = wrap end
                m = wrap
            end
        end
        if not m then
            local ok2, m2 = pcall(function() return game:GetService("InsertService"):LoadAsset(tonumber(id)) end)
            if ok2 and m2 then m = m2 end
        end
        return m
    end

    function ILHABLOX.spawn(partnerName)
        notify("Ilha do Blox", "Carregando o mapa do Blox Fruits...")
        ILHABLOX.clear(true)
        local myToken = ILHABLOX.token

        local S = {}
        ILHABLOX.S = S
        local folder = Instance.new("Folder")
        folder.Name = "IlhaDoBlox"
        folder.Parent = workspace
        S.folder = folder

        -- ===== carrega a ILHA =====
        local model = loadModel(ILHABLOX.MODEL_ID)
        if ILHABLOX.token ~= myToken then return end
        if not model then
            notify("Ilha do Blox", "Não consegui carregar o mapa (ID " .. ILHABLOX.MODEL_ID .. ").")
            pcall(function() folder:Destroy() end)
            ILHABLOX.S = nil
            return
        end

        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then p.Anchored = true p.CanCollide = true end
        end
        if not model.PrimaryPart then model.PrimaryPart = model:FindFirstChildWhichIsA("BasePart", true) end
        model.Parent = folder

        -- posiciona a ilha (base encostando em BASE)
        local spawnCF = CFrame.new(BASE + Vector3.new(0, 50, 0))
        if model.PrimaryPart then
            local bcf, bs = model:GetBoundingBox()
            local bo = model:GetPivot().Position.Y - (bcf.Position.Y - bs.Y / 2)
            model:PivotTo(CFrame.new(BASE.X, BASE.Y + bo, BASE.Z))

            local bcf2, bs2 = model:GetBoundingBox()
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Include
            rp.FilterDescendantsInstances = { model }
            local topY = bcf2.Position.Y + bs2.Y / 2
            local res = workspace:Raycast(Vector3.new(bcf2.Position.X, topY + 400, bcf2.Position.Z), Vector3.new(0, -3000, 0), rp)
            local landY = res and res.Position.Y or topY
            spawnCF = CFrame.new(bcf2.Position.X, landY + 6, bcf2.Position.Z)
        end

        -- ===== carrega as ÁGUAS em volta da ilha =====
        if ILHABLOX.WATER_ID and ILHABLOX.WATER_ID ~= "" then
            local waterModel = loadModel(ILHABLOX.WATER_ID)
            if ILHABLOX.token ~= myToken then return end
            if waterModel then
                for _, p in ipairs(waterModel:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.Anchored = true
                        p.CanCollide = true
                        p.CanQuery = true
                        p.CanTouch = true
                    end
                end
                if not waterModel.PrimaryPart then
                    waterModel.PrimaryPart = waterModel:FindFirstChildWhichIsA("BasePart", true)
                end
                waterModel.Parent = folder

                if waterModel.PrimaryPart and model.PrimaryPart then
                    -- centraliza as águas no X/Z da ilha, com a base alinhada ao mesmo
                    -- nível vertical (BASE.Y) — assim o mar fica em volta da terra
                    local ibcf = model:GetBoundingBox()
                    local wbcf, wbs = waterModel:GetBoundingBox()
                    local wbo = waterModel:GetPivot().Position.Y - (wbcf.Position.Y - wbs.Y / 2)
                    waterModel:PivotTo(CFrame.new(ibcf.Position.X, BASE.Y + wbo, ibcf.Position.Z))
                end
            else
                notify("Ilha do Blox", "Aviso: não carregou as águas (ID " .. ILHABLOX.WATER_ID .. "). A ilha continua.")
            end
        end

        -- ===== iluminação =====
        ILHABLOX.saved = {}
        for _, k in ipairs(LIGHT_PROPS) do pcall(function() ILHABLOX.saved[k] = Lighting[k] end) end
        local function set(k, v) pcall(function() Lighting[k] = v end) end
        set("ClockTime", 13)
        set("Brightness", 2)
        set("GlobalShadows", true)
        -- deixa o céu/fog bonitos pra combinar com o mar
        set("FogColor", Color3.fromRGB(180, 215, 235))
        set("FogStart", 200)
        set("FogEnd", 5000)
        set("Ambient", Color3.fromRGB(140, 170, 190))
        set("OutdoorAmbient", Color3.fromRGB(150, 180, 200))

        -- ===== teleporte =====
        local function teleportMe()
            local chr = LocalPlayer.Character
            local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Anchored = true
                hrp.CFrame = spawnCF
                task.wait(0.3)
                hrp.Anchored = false
            end
        end
        teleportMe()
        if partnerName and partnerName ~= "" then
            local partner = Players:FindFirstChild(partnerName)
            if partner and partner.Character and partner.Character:FindFirstChild("HumanoidRootPart") then
                partner.Character.HumanoidRootPart.CFrame = spawnCF + Vector3.new(6, 0, 0)
            end
        end

        S.charConn = LocalPlayer.CharacterAdded:Connect(function(c)
            local h = c:WaitForChild("HumanoidRootPart", 10)
            if h and ILHABLOX.token == myToken then
                task.wait(0.5)
                h.AssemblyLinearVelocity = Vector3.zero
                h.CFrame = spawnCF
            end
        end)

        notify("Ilha do Blox", "Pronto! Mapa do Blox Fruits + águas carregados.")
        return true
    end
end

-- ================== FLASH & AURA (REDE) ==================
local FXNET = {
    flash = {},
    aura  = {},
    actions = { FLASH_ON = true, FLASH_OFF = true, AURA_ON = true, AURA_OFF = true },
}

do
    local Debris         = game:GetService("Debris")
    local TweenService   = game:GetService("TweenService")
    local rand           = math.random
    local function rr(a, b) return a + (b - a) * rand() end

    local GOLD   = Color3.fromRGB(255, 200, 0)
    local BRIGHT = Color3.fromRGB(255, 235, 110)
    local CORE   = Color3.fromRGB(255, 248, 200)
    local ORANGE = Color3.fromRGB(255, 140, 0)

    local function fxFolder()
        local cam = workspace.CurrentCamera
        local f = cam:FindFirstChild("F1L_FX")
        if not f then
            f = Instance.new("Folder")
            f.Name = "F1L_FX"
            f.Parent = cam
        end
        return f
    end

    local function clearObjs(st)
        for _, o in ipairs(st.objs) do pcall(function() o:Destroy() end) end
        st.objs = {}
    end

    local function bolt(p0, p1, thick, straight)
        local dist = (p1 - p0).Magnitude
        if dist < 0.5 then return end
        local segs = math.clamp(math.floor(dist * 1.6), 5, 24)
        local cf = CFrame.lookAt(p0, p1)
        local jit = dist * (straight and 0.01 or 0.075)

        local part = Instance.new("Part")
        part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch = true, false, false, false
        part.Transparency = 1
        part.Size = Vector3.new(0.1, 0.1, 0.1)
        part.CFrame = CFrame.new(p0)
        part.Parent = fxFolder()

        local atts = {}
        for i = 0, segs do
            local j = (i == 0 or i == segs) and 0 or jit
            local a = Instance.new("Attachment")
            a.Parent = part
            a.WorldPosition = p0:Lerp(p1, i / segs)
                + cf.RightVector * (rand() - 0.5) * 2 * j
                + cf.UpVector * (rand() - 0.5) * 2 * j
            atts[i + 1] = a
        end

        for i = 1, segs do
            for _, L in ipairs({
                { Color3.fromRGB(255, 215, 40), 0.55 * thick, 0.6 },
                { Color3.new(1, 1, 1),          0.14 * thick, 0   },
            }) do
                local b = Instance.new("Beam")
                b.Attachment0, b.Attachment1 = atts[i], atts[i + 1]
                b.Segments, b.FaceCamera = 1, true
                b.Color = ColorSequence.new(L[1])
                b.LightEmission, b.LightInfluence = 1, 0
                b.Width0, b.Width1 = L[2], L[2]
                b.Transparency = NumberSequence.new(L[3])
                b.Parent = part
            end
        end
        Debris:AddItem(part, rr(0.07, 0.13))
    end

    local function flashApply(plr, st)
        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not root then return end

        clearObjs(st)
        st.char = char
        local function keep(o) table.insert(st.objs, o) return o end

        if plr == LocalPlayer and hum then hum.WalkSpeed = 200 end

        local att = keep(Instance.new("Attachment"))
        att.Parent = root
        local em = Instance.new("ParticleEmitter")
        em.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
            ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 230, 60)),
            ColorSequenceKeypoint.new(1, ORANGE),
        })
        em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
        em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
        em.Rate, em.Lifetime, em.Speed = 60, NumberRange.new(0.1, 0.3), NumberRange.new(8, 20)
        em.SpreadAngle = Vector2.new(360, 360)
        em.LightEmission = 1
        em.Parent = att

        local top = keep(Instance.new("Attachment"))
        top.Position = Vector3.new(0, 2, 0)
        top.Parent = root
        local bot = keep(Instance.new("Attachment"))
        bot.Position = Vector3.new(0, -2, 0)
        bot.Parent = root
        local trail = keep(Instance.new("Trail"))
        trail.Attachment0, trail.Attachment1 = top, bot
        trail.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
            ColorSequenceKeypoint.new(0.3, Color3.fromRGB(255, 220, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 120, 0)),
        })
        trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
        trail.LightEmission, trail.Lifetime, trail.MinLength = 1, 0.3, 0.01
        trail.Parent = root

        local light = keep(Instance.new("PointLight"))
        light.Color, light.Brightness, light.Range = Color3.fromRGB(255, 220, 60), 3, 14
        light.Parent = root

        local hl = keep(Instance.new("Highlight"))
        hl.FillColor, hl.OutlineColor = Color3.fromRGB(255, 220, 40), Color3.new(1, 1, 1)
        hl.FillTransparency, hl.OutlineTransparency = 0.88, 0.3
        hl.DepthMode = Enum.HighlightDepthMode.Occluded
        hl.Parent = char

        task.spawn(function()
            while FXNET.flash[plr.Name] == st and st.char == char and root.Parent do
                local vel = root.AssemblyLinearVelocity
                local speed = vel.Magnitude
                local qtd = speed > 25 and 3 or (speed > 5 and 2 or 1)

                for _ = 1, qtd do
                    local origem = root.Position + Vector3.new(rr(-1.3, 1.3), rr(-2.6, 2.2), rr(-1.3, 1.3))
                    local rnd = Vector3.new(rand() - 0.5, rand() - 0.5, rand() - 0.5)
                    if rnd.Magnitude < 0.01 then rnd = Vector3.new(0, 1, 0) end
                    local velH = Vector3.new(vel.X, 0, vel.Z)

                    if velH.Magnitude > 20 then
                        local dir = (-velH.Unit + rnd.Unit * 0.06).Unit
                        bolt(origem, origem + dir * rr(18, 36), rr(0.9, 1.3), true)
                    else
                        local dir = rnd.Unit
                        if speed > 5 then dir = (dir * 0.8 - vel.Unit * 0.9).Unit end
                        bolt(origem, origem + dir * rr(10, 20), rr(0.8, 1.3), false)
                    end
                end

                light.Brightness = rr(2, 6)
                hl.FillTransparency = rr(0.78, 0.93)
                task.wait(rr(0.03, 0.07))
            end
        end)
    end

    function FXNET.flashOn(plr)
        if not plr or FXNET.flash[plr.Name] then return end
        local st = { objs = {} }
        FXNET.flash[plr.Name] = st
        st.conn = plr.CharacterAdded:Connect(function(c)
            c:WaitForChild("HumanoidRootPart", 10)
            task.wait(0.5)
            if FXNET.flash[plr.Name] == st then flashApply(plr, st) end
        end)
        flashApply(plr, st)
    end

    function FXNET.flashOff(name)
        local st = FXNET.flash[name]
        if not st then return end
        FXNET.flash[name] = nil
        if st.conn then st.conn:Disconnect() end
        clearObjs(st)
        local plr = Players:FindFirstChild(name)
        if plr == LocalPlayer then
            local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = 16 end
        end
    end

    local function column(groundPos, height, thick)
        local part = Instance.new("Part")
        part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch = true, false, false, false
        part.Transparency = 1
        part.Size = Vector3.new(0.1, 0.1, 0.1)
        part.CFrame = CFrame.new(groundPos)
        part.Parent = fxFolder()

        local a0 = Instance.new("Attachment")
        a0.Parent = part
        local a1 = Instance.new("Attachment")
        a1.Position = Vector3.new(rr(-0.7, 0.7), height, rr(-0.7, 0.7))
        a1.Parent = part

        for _, L in ipairs({
            { GOLD, 0.55 * thick, 0.05, 0.5, 1 },
            { CORE, 0.16 * thick, 0,    0,   0.8 },
        }) do
            local b = Instance.new("Beam")
            b.Attachment0, b.Attachment1 = a0, a1
            b.Segments, b.FaceCamera = 1, true
            b.Color = ColorSequence.new(L[1])
            b.LightEmission, b.LightInfluence = 1, 0
            b.Width0, b.Width1 = L[2], L[3]
            b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, L[4]), NumberSequenceKeypoint.new(1, L[5]) })
            b.Parent = part
        end
        Debris:AddItem(part, 0.35)
    end

    local function wave(groundPos, finalSize)
        local w = Instance.new("Part")
        w.Shape = Enum.PartType.Cylinder
        w.Anchored, w.CanCollide, w.CanQuery, w.CanTouch = true, false, false, false
        w.Material, w.Color, w.Transparency = Enum.Material.Neon, GOLD, 0.3
        w.Size = Vector3.new(0.2, 4, 4)
        w.CFrame = CFrame.new(groundPos + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90))
        w.Parent = fxFolder()
        TweenService:Create(w, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = Vector3.new(0.2, finalSize, finalSize),
            Transparency = 1,
        }):Play()
        Debris:AddItem(w, 1)
    end

    local function auraApply(plr, st)
        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        clearObjs(st)
        st.char = char
        local function keep(o) table.insert(st.objs, o) return o end

        local groundDist = hum.RigType == Enum.HumanoidRigType.R6 and 3 or (hum.HipHeight + root.Size.Y / 2)

        local hl = keep(Instance.new("Highlight"))
        hl.FillColor, hl.OutlineColor = GOLD, BRIGHT
        hl.FillTransparency, hl.OutlineTransparency = 0.8, 0.1
        hl.DepthMode = Enum.HighlightDepthMode.Occluded
        hl.Parent = char

        local light = keep(Instance.new("PointLight"))
        light.Color, light.Brightness, light.Range = GOLD, 4, 24
        light.Parent = root

        local parts = {}
        for _, p in ipairs(char:GetChildren()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then table.insert(parts, p) end
        end
        local n = math.max(#parts, 1)
        for _, p in ipairs(parts) do
            local att = keep(Instance.new("Attachment"))
            att.Parent = p
            local s = math.clamp(p.Size.Magnitude * 0.9, 1.2, 3)
            local fl = Instance.new("ParticleEmitter")
            fl.Texture = "rbxasset://textures/particles/fire_main.dds"
            fl.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, CORE),
                ColorSequenceKeypoint.new(0.35, GOLD),
                ColorSequenceKeypoint.new(1, ORANGE),
            })
            fl.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, s), NumberSequenceKeypoint.new(1, 0) })
            fl.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
            fl.Lifetime = NumberRange.new(0.5, 0.9)
            fl.Rate = math.max(2, 130 / n)
            fl.Speed = NumberRange.new(1, 3)
            fl.SpreadAngle = Vector2.new(12, 12)
            fl.EmissionDirection = Enum.NormalId.Top
            fl.Acceleration = Vector3.new(0, 7, 0)
            fl.Rotation, fl.RotSpeed = NumberRange.new(0, 360), NumberRange.new(-30, 30)
            fl.LightEmission = 1
            fl.LockedToPart = false
            fl.Parent = att
        end

        local attRoot = keep(Instance.new("Attachment"))
        attRoot.Parent = root

        local fog = Instance.new("ParticleEmitter")
        fog.Texture = "rbxasset://textures/particles/smoke_main.dds"
        fog.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, BRIGHT),
            ColorSequenceKeypoint.new(0.5, GOLD),
            ColorSequenceKeypoint.new(1, ORANGE),
        })
        fog.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 9) })
        fog.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 1) })
        fog.Lifetime, fog.Rate, fog.Speed = NumberRange.new(0.7, 1.2), 34, NumberRange.new(2, 5)
        fog.SpreadAngle = Vector2.new(30, 30)
        fog.EmissionDirection = Enum.NormalId.Top
        fog.LightEmission = 1
        fog.Rotation, fog.RotSpeed = NumberRange.new(0, 360), NumberRange.new(-40, 40)
        fog.Parent = attRoot

        local sp = Instance.new("ParticleEmitter")
        sp.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
            ColorSequenceKeypoint.new(0.4, GOLD),
            ColorSequenceKeypoint.new(1, ORANGE),
        })
        sp.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
        sp.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
        sp.Lifetime, sp.Rate, sp.Speed = NumberRange.new(0.9, 1.8), 55, NumberRange.new(5, 14)
        sp.SpreadAngle = Vector2.new(40, 40)
        sp.EmissionDirection = Enum.NormalId.Top
        sp.Acceleration = Vector3.new(0, 5, 0)
        sp.LightEmission = 1
        sp.Parent = attRoot

        local function ring(d, t, off)
            local a = keep(Instance.new("Part"))
            a.Shape = Enum.PartType.Cylinder
            a.Size = Vector3.new(0.2, d, d)
            a.Material, a.Color, a.Transparency = Enum.Material.Neon, GOLD, t
            a.CanCollide, a.CanQuery, a.CanTouch, a.Massless = false, false, false, true
            a.CFrame = root.CFrame * CFrame.new(0, -(groundDist - off), 0) * CFrame.Angles(0, 0, math.rad(90))
            a.Parent = char
            local w = Instance.new("WeldConstraint")
            w.Part0, w.Part1, w.Parent = root, a, a
            return a
        end
        local r1, r2 = ring(6, 0.5, 0), ring(9, 0.7, 0.05)

        if plr == LocalPlayer then
            local bloom = keep(Instance.new("BloomEffect"))
            bloom.Intensity, bloom.Size, bloom.Threshold = 0.8, 28, 0.85
            bloom.Parent = Lighting
        end

        task.spawn(function()
            local tc, tw = 0, 0
            while FXNET.aura[plr.Name] == st and st.char == char and root.Parent do
                local dt = task.wait()
                local pulse = (math.sin(os.clock() * 4) + 1) / 2

                hl.FillTransparency = 0.7 + 0.2 * pulse
                light.Brightness = 3 + 3 * pulse
                local d1, d2 = 6 + 1.2 * pulse, 9 + 1.5 * (1 - pulse)
                r1.Size, r2.Size = Vector3.new(0.2, d1, d1), Vector3.new(0.2, d2, d2)
                r1.Transparency, r2.Transparency = 0.4 + 0.35 * pulse, 0.6 + 0.3 * (1 - pulse)

                local ground = root.Position - Vector3.new(0, groundDist, 0)

                tc += dt
                if tc >= 0.05 then
                    tc = 0
                    for _ = 1, 3 do
                        local ang, rad = rand() * math.pi * 2, rr(1.8, 3.8)
                        column(ground + Vector3.new(math.cos(ang) * rad, 0, math.sin(ang) * rad), rr(7, 16) * 1.4, rr(0.8, 1.3))
                    end
                end

                tw += dt
                if tw >= 1.1 then
                    tw = 0
                    wave(ground, 34)
                end
            end
        end)
    end

    function FXNET.auraOn(plr)
        if not plr or FXNET.aura[plr.Name] then return end
        local st = { objs = {} }
        FXNET.aura[plr.Name] = st
        st.conn = plr.CharacterAdded:Connect(function(c)
            c:WaitForChild("HumanoidRootPart", 10)
            c:WaitForChild("Humanoid", 10)
            task.wait(0.6)
            if FXNET.aura[plr.Name] == st then auraApply(plr, st) end
        end)
        auraApply(plr, st)
    end

    function FXNET.auraOff(name)
        local st = FXNET.aura[name]
        if not st then return end
        FXNET.aura[name] = nil
        if st.conn then st.conn:Disconnect() end
        clearObjs(st)
    end

    function FXNET.run(action, name)
        if not name or name == "" then return end
        local isOn = action:sub(-3) == "_ON"
        local kind = action:sub(1, 5) == "FLASH" and "flash" or "aura"

        local targets = {}
        if name == "ALL" then
            if isOn then
                for n in pairs(activeScriptUsers) do table.insert(targets, n) end
            else
                for n in pairs(FXNET[kind]) do table.insert(targets, n) end
            end
        else
            targets = { name }
        end

        for _, n in ipairs(targets) do
            if isOn then
                local plr = Players:FindFirstChild(n)
                if plr then FXNET[kind .. "On"](plr) end
            else
                FXNET[kind .. "Off"](n)
            end
        end
    end

    function FXNET.send(action, name)
        if not name or name == "" then return end
        FXNET.run(action, name)
        sendNetCmd(";" .. action .. " " .. name)
        notify("Hub", action .. " → " .. name)
    end

    Players.PlayerRemoving:Connect(function(p)
        FXNET.flashOff(p.Name)
        FXNET.auraOff(p.Name)
    end)
end

-- ================== BRAINROT + PATCH v37 ==================
local BRAIN = { token = 0, S = nil, saved = nil, hidden = {}, count = 0, cache = {} }

do
    local Debris = game:GetService("Debris")

    local START_MONEY = 2e12

    local C_GRASS = Color3.fromRGB(58, 196, 72)

    local BRAINROTS = {
        { name = "Noobini Pizzanini", rarity = "Common", rc = Color3.fromRGB(90, 230, 90), inc = 1, price = 25, w = 55,
          asset = 88544724314302, sound = 110659131769092, yaw = 0, col = Color3.fromRGB(240, 225, 70), col2 = Color3.fromRGB(70, 160, 255) },
        { name = "67", rarity = "Secret", rc = Color3.fromRGB(255, 70, 200), inc = 7.5e6, price = 1.25e9, w = 30,
          asset = 189020661701506, sound = 106000088638410, yaw = 0, col = Color3.fromRGB(60, 60, 70), col2 = Color3.fromRGB(240, 240, 240) },
        { name = "Strawberry Elephant", rarity = "Secret", rc = Color3.fromRGB(255, 70, 200), inc = 7.5e8, price = 7.5e11, w = 15,
          asset = 248295212434663, sound = 89155583651513, yaw = 0, col = Color3.fromRGB(255, 120, 150), col2 = Color3.fromRGB(255, 190, 205) },
    }
    local LIGHT_PROPS = {
        "Ambient", "OutdoorAmbient", "Brightness", "ClockTime", "FogStart", "FogEnd", "FogColor",
        "GlobalShadows", "ExposureCompensation", "ColorShift_Top", "ColorShift_Bottom",
        "EnvironmentDiffuseScale", "EnvironmentSpecularScale",
    }

    local function fmt(n)
        local units = { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }
        for _, u in ipairs(units) do
            if n >= u[1] then
                local s = string.format("%.2f", n / u[1])
                s = (s:gsub("(%..-)0+$", "%1"))
                s = (s:gsub("%.$", ""))
                return s .. u[2]
            end
        end
        return tostring(math.floor(n))
    end

    local function playSound(id)
        if not id then return end
        pcall(function()
            local s = Instance.new("Sound")
            s.SoundId = "rbxassetid://" .. id
            s.Volume = 2
            s.Parent = workspace
            s:Play()
            Debris:AddItem(s, 20)
        end)
    end

    local function fetchObjects(id)
        local lastErr = "desconhecido"
        for _ = 1, 2 do
            for _, url in ipairs({ "rbxassetid://" .. id, "http://www.roblox.com/asset/?id=" .. id }) do
                local ok, objs = pcall(function() return game:GetObjects(url) end)
                if ok and objs and #objs > 0 then return objs end
                lastErr = ok and "retornou vazio" or tostring(objs)
            end
            local ok2, mdl = pcall(function() return game:GetService("InsertService"):LoadAsset(tonumber(id)) end)
            if ok2 and mdl then
                local kids = mdl:GetChildren()
                if #kids > 0 then return kids end
            end
            task.wait(0.6)
        end
        return nil, lastErr
    end

    local function loadTemplate(def)
        local c = BRAIN.cache[def.asset]
        if c ~= nil then return c or nil end

        local ids = { def.asset }
        for _, a in ipairs(def.alt or {}) do table.insert(ids, a) end

        local tpl, reason
        for _, id in ipairs(ids) do
            local objs, err = fetchObjects(id)
            if objs then
                local m = Instance.new("Model")
                for _, o in ipairs(objs) do o.Parent = m end
                for _, d in ipairs(m:GetDescendants()) do
                    if d:IsA("LuaSourceContainer") or d:IsA("Humanoid") or d:IsA("ProximityPrompt") then
                        pcall(function() d:Destroy() end)
                    end
                end
                for _, d in ipairs(m:GetDescendants()) do
                    if d:IsA("BasePart") then tpl = m break end
                end
                if tpl then break end
                reason = "asset " .. id .. " carregou mas não tem nenhuma peça (BasePart)"
            else
                reason = "asset " .. id .. ": " .. tostring(err)
            end
        end

        if not tpl then
            warn("[Brainrot] " .. def.name .. " -> " .. tostring(reason))
            notify("Brainrot", def.name .. " não carregou (" .. tostring(reason):sub(1, 70) .. "). Veja o F9.")
        end
        BRAIN.cache[def.asset] = tpl or false
        return tpl
    end

    local function makeBrainrot(def, parent)
        local tpl = loadTemplate(def)
        local m = Instance.new("Model")
        m.Name = def.name
        local root = Instance.new("Part")
        root.Name = "Root"
        root.Size = Vector3.new(1, 1, 1)
        root.Transparency = 1
        root.Anchored = true
        root.CanCollide = false
        root.CanTouch = false
        root.Parent = m
        m.PrimaryPart = root

        local height
        if tpl then
            local clone = tpl:Clone()
            for _, d in ipairs(clone:GetDescendants()) do
                if d:IsA("BasePart") then
                    d.Anchored = true
                    d.CanCollide = false
                end
            end
            clone.Parent = m
            local cf, size = clone:GetBoundingBox()
            root.CFrame = CFrame.new(cf.Position.X, cf.Position.Y - size.Y / 2, cf.Position.Z)
            height = size.Y
        else
            local function part(sz, off, col)
                local p = Instance.new("Part")
                p.Anchored = true
                p.CanCollide = false
                p.Size = sz
                p.Color = col
                p.Material = Enum.Material.SmoothPlastic
                p.TopSurface = Enum.SurfaceType.Smooth
                p.BottomSurface = Enum.SurfaceType.Smooth
                p.CFrame = CFrame.new(off)
                p.Parent = m
                return p
            end
            part(Vector3.new(3.2, 3.6, 2.2), Vector3.new(0, 3.2, 0), def.col)
            part(Vector3.new(3.4, 3, 3), Vector3.new(0, 5.9, 0), def.col2)
            for _, sx in ipairs({ -0.8, 0.8 }) do
                part(Vector3.new(0.9, 0.9, 0.4), Vector3.new(sx, 6.2, -1.5), Color3.new(1, 1, 1))
                part(Vector3.new(0.4, 0.4, 0.2), Vector3.new(sx, 6.2, -1.78), Color3.new(0, 0, 0))
                part(Vector3.new(1, 2, 1), Vector3.new(sx, 1, 0), def.col2)
            end
            root.CFrame = CFrame.new(0, 0, 0)
            height = 7.5
        end

        local anchor = Instance.new("Attachment")
        anchor.Name = "PromptAnchor"
        anchor.Position = Vector3.new(0, height / 2, 0)
        anchor.Parent = root

        local bb = Instance.new("BillboardGui")
        bb.Name = "Info"
        bb.Size = UDim2.new(0, 170, 0, 76)
        bb.StudsOffset = Vector3.new(0, height + 2.5, 0)
        bb.MaxDistance = 160
        bb.Adornee = root
        bb.Parent = root
        local function lab(name, text, color, y)
            local l = Instance.new("TextLabel")
            l.Name = name
            l.BackgroundTransparency = 1
            l.Size = UDim2.new(1, 0, 0.25, 0)
            l.Position = UDim2.new(0, 0, y, 0)
            l.Text = text
            l.TextColor3 = color
            l.TextStrokeTransparency = 0
            l.Font = Enum.Font.GothamBold
            l.TextScaled = true
            l.Parent = bb
        end
        lab("Name", def.name, Color3.new(1, 1, 1), 0)
        lab("Rarity", def.rarity, def.rc, 0.25)
        lab("Inc", "$" .. fmt(def.inc) .. "/s", Color3.fromRGB(90, 255, 110), 0.5)
        lab("Price", "$" .. fmt(def.price), Color3.fromRGB(255, 225, 80), 0.75)
        m.Parent = parent
        return m
    end

    local function setPrompt(model, action, hold, cb)
        local root = model.PrimaryPart
        local anchor = root:FindFirstChild("PromptAnchor") or root
        local old = anchor:FindFirstChildOfClass("ProximityPrompt")
        if old then old:Destroy() end
        local pp = Instance.new("ProximityPrompt")
        pp.ActionText = action
        pp.ObjectText = model.Name
        pp.HoldDuration = hold
        pp.MaxActivationDistance = 14
        pp.RequiresLineOfSight = false
        pp.Parent = anchor
        pp.Triggered:Connect(cb)
        return pp
    end

    local function setPriceText(model, text)
        local info = model.PrimaryPart and model.PrimaryPart:FindFirstChild("Info")
        local l = info and info:FindFirstChild("Price")
        if l then l.Text = text end
    end

    local function setMoney(S)
        if S.hudMoney then S.hudMoney.Text = "  $" .. fmt(S.money) end
        if S.hudInc then S.hudInc.Text = "  +$" .. fmt(S.income) .. "/s" end
    end

    local function freeSlot(slots)
        for _, s in ipairs(slots) do
            if not s.model then return s end
        end
    end

    local function placeModel(model, slot, def)
        local p = slot.pos
        model:PivotTo(CFrame.lookAt(p, p + slot.look) * CFrame.Angles(0, math.rad(def.yaw or 0), 0))
    end

    local function claimMine(S, model, def, slot)
        slot.model = model
        slot.def = def
        placeModel(model, slot, def)
        S.income += def.inc
        setPriceText(model, "Seu  |  vender $" .. fmt(math.floor(def.price / 2)))
        setMoney(S)
        playSound(def.sound)
        setPrompt(model, "Vender", 0.8, function()
            if slot.model ~= model then return end
            slot.model, slot.def = nil, nil
            S.money += math.floor(def.price / 2)
            S.income -= def.inc
            setMoney(S)
            model:Destroy()
        end)
    end

    local function makeHud(S)
        local pg = LocalPlayer:WaitForChild("PlayerGui")
        local sg = Instance.new("ScreenGui")
        sg.Name = "BrainrotHUD"
        sg.ResetOnSpawn = false
        sg.Parent = pg
        local function box(y, size, color)
            local l = Instance.new("TextLabel")
            l.Size = UDim2.new(0, 260, 0, y == 70 and 40 or 26)
            l.Position = UDim2.new(0, 12, 0, y)
            l.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
            l.BackgroundTransparency = 0.3
            l.TextColor3 = color
            l.Font = Enum.Font.GothamBlack
            l.TextSize = size
            l.TextXAlignment = Enum.TextXAlignment.Left
            l.Parent = sg
            Instance.new("UICorner", l).CornerRadius = UDim.new(0, 8)
            return l
        end
        S.hudMoney = box(70, 24, Color3.fromRGB(90, 255, 110))
        S.hudInc = box(114, 16, Color3.fromRGB(255, 225, 80))
        S.gui = sg
        setMoney(S)
    end

    function BRAIN.clear(silent)
        BRAIN.token += 1
        local S = BRAIN.S
        BRAIN.S = nil
        if S then
            if S.conn then pcall(function() S.conn:Disconnect() end) end
            if S.charConn then pcall(function() S.charConn:Disconnect() end) end
            if S.folder then pcall(function() S.folder:Destroy() end) end
            if S.gui then pcall(function() S.gui:Destroy() end) end
        end
        for _, n in ipairs({ "BR_Sky", "BR_CC" }) do
            local o = Lighting:FindFirstChild(n)
            if o then o:Destroy() end
        end
        for _, a in ipairs(BRAIN.hidden) do
            pcall(function() a.Parent = Lighting end)
        end
        BRAIN.hidden = {}
        local sv = BRAIN.saved
        BRAIN.saved = nil
        if sv then
            for k, v in pairs(sv) do pcall(function() Lighting[k] = v end) end
        end
        -- limpa o cache do pack (pra recarregar na próxima vez)
        for k in pairs(BRAIN.cache) do
            if tostring(k):find("^pack_") then BRAIN.cache[k] = nil end
        end
        if S and not silent then notify("Brainrot", "Mundo removido.") end
        return true
    end

    -- ===== CONFIG DO NOVO BRAINROT =====
    BRAIN.CFG = {
        MAP_ID   = "101491434169003",
        PACK_ID  = "72466520546640",
        MAP_BASE = Vector3.new(33000, 500, 0),  -- onde o mapa nasce (longe dos outros)
        SPEED    = 12,                          -- velocidade na esteira
        GAP      = 1.2,                         -- pausa entre um brainrot e o próximo
    }

    function BRAIN.spawn()
        notify("Brainrot", "Carregando o mapa...")
        BRAIN.clear(true)
        pcall(POOL.clear, true)
        if workspace:FindFirstChild("Backrooms_Level0") then pcall(clearBackrooms) end
        local myToken = BRAIN.token
        local CFG = BRAIN.CFG

        local S = { money = START_MONEY, income = 0, pending = 0, walkers = {}, mySlots = {} }
        BRAIN.S = S
        local f = Instance.new("Folder")
        f.Name = "RoubeUmBrainrot_World"
        f.Parent = workspace
        S.folder = f

        -- ===== carrega o MAPA =====
        local mobjs, merr = fetchObjects(CFG.MAP_ID)
        if BRAIN.token ~= myToken then return end
        if not mobjs then
            notify("Brainrot", "Não consegui carregar o mapa (" .. tostring(merr):sub(1, 60) .. ")")
    
